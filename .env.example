# 로컬 개발용 예시. 복사해서 사용: cp .env.example .env
# .env 파일은 Git에 올리지 않는다.

# 개발 중에만 True. 운영 서버에서는 반드시 False.
DJANGO_DEBUG=True

# 운영에서는 반드시 긴 무작위 값으로 설정 (DEBUG=False 인데 비어 있으면 서버가 시작되지 않음)
# 생성: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# 접속 허용 호스트 (쉼표 구분). 스마트폰으로 같은 Wi-Fi에서 테스트할 때는 PC의 내부 IP 추가.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS 도메인 사용 시 (예: https://example.com). 비워두면 사용 안 함.
DJANGO_CSRF_TRUSTED_ORIGINS=

# HTTPS 운영(호스팅·Nginx가 HTTPS를 처리하는 경우)에서만 True: HTTPS 이동·보안 쿠키·프록시 헤더 신뢰
# DJANGO_HTTPS=False
# HSTS 기간(초). 주소가 확정되기 전에는 0 유지 (한 번 켜면 되돌리기 어려움)
# DJANGO_HSTS_SECONDS=0

# SQLite 파일 위치 (비워두면 프로젝트 루트의 db.sqlite3)
# DJANGO_SQLITE_PATH=

# 화면 상태 미리보기(?preview=...) 사용 여부. 비워두면 DJANGO_DEBUG 와 같음
# LOLYPOLY_STATE_PREVIEW=

# 수집 주기(일). 마지막 성공 후 '주기+1일'이 지나면 화면에 '오래된 데이터'로 표시.
# 서버의 자동 수집 타이머(deploy/systemd/*.timer) 주기와 맞춰야 한다. 비워두면 7.
# 시범 운영 초기값(D-040): 식단·학사일정 하루 1회, 공지 하루 3회 → 모두 1일
# LOLYPOLY_INTERVAL_MEALS=1
# LOLYPOLY_INTERVAL_EVENTS=1
# LOLYPOLY_INTERVAL_NOTICES=1

# 수집기 설정 (선택): 페이지 대기 시간(ms), 페이지 이동 사이 대기(초)
# LOLYPOLY_COLLECTOR_TIMEOUT_MS=30000
# LOLYPOLY_COLLECTOR_DELAY_SEC=2

# ── 학교 PC 운영 (docs/OPERATIONS.md) ──
# DB·백업·락을 코드 폴더 밖 영구 경로에 둔다 (예: /var/lib/lolypoly/db.sqlite3)
# DJANGO_SQLITE_PATH=/var/lib/lolypoly/db.sqlite3
# DJANGO_ALLOWED_HOSTS=lolypoly.com,www.lolypoly.com,localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://lolypoly.com,https://www.lolypoly.com
# DJANGO_HTTPS=True
# Nginx 가 X-Real-IP 를 덮어쓰는 구조에서만 True (의견 폼 도배 제한의 접속 주소 판별)
# LOLYPOLY_TRUST_PROXY_IP=True
