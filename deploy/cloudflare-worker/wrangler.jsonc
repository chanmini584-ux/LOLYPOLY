// Lolypoly 공개 입구 Worker. 배포: npx wrangler deploy (이 폴더에서, wrangler login 필요)
// 주소: https://lolypoly.<계정 workers.dev 이름>.workers.dev
{
  "name": "lolypoly",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Workers VPC: 터널 lolypoly(5d947b5d-…) 너머 강의실 PC 127.0.0.1:8000
  "vpc_services": [
    { "binding": "LOLYPOLY_PC", "service_id": "01a1a98a-0dc8-7ab2-8cfa-0cb10cfa33ec" }
    // 엔진 v0.6.0 공개 경로(/rag/v1/public/chat): 같은 터널로 127.0.0.1:8088 을 가리키는 VPC 서비스를 만든 뒤 아래 줄을 켠다.
    // 서비스 만들기·배포는 주상 승인 후(외부 공개). 만들기 전까지 /rag/ 는 503(rag_not_configured).
    // , { "binding": "RAG_ENGINE", "service_id": "<엔진 8088 VPC 서비스 ID>" }
  ]
}
