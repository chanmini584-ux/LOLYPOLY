# Lolypoly 학사일정 자동 수집 — 하루 1회 (서울 시간). 시범 운영 초기값(D-040).
# 주기를 바꾸려면 OnCalendar 를 고치고, .env 의 LOLYPOLY_INTERVAL_EVENTS (일 단위)도 맞춘다.
[Unit]
Description=Lolypoly 학사일정 자동 수집 타이머

[Timer]
OnCalendar=*-*-* 06:25:00 Asia/Seoul
Persistent=true
RandomizedDelaySec=5min
Unit=lolypoly-collect@events.service

[Install]
WantedBy=timers.target
