# Lolypoly 웹앱 (Gunicorn). Nginx(또는 터널)가 127.0.0.1:8000 으로 전달한다. runserver 는 쓰지 않는다.
# install.sh 가 __APP_DIR__, __APP_USER__ 를 바꿔 설치한다. 환경값은 <앱 경로>/.env 에서 읽는다.
[Unit]
Description=Lolypoly 웹앱 (Gunicorn)
After=network.target

[Service]
User=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=TZ=Asia/Seoul
ExecStart=__APP_DIR__/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 30 --access-logfile - --error-logfile -
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
