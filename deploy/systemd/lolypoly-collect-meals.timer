# Lolypoly 식단 자동 수집 — 하루 1회 (서울 시간). 시범 운영 초기값(D-040).
# 주기를 바꾸려면 OnCalendar 를 고치고, .env 의 LOLYPOLY_INTERVAL_MEALS (일 단위)도 맞춘다.
# 확인: systemctl list-timers 'lolypoly-*'
[Unit]
Description=Lolypoly 식단 자동 수집 타이머

[Timer]
OnCalendar=*-*-* 06:10:00 Asia/Seoul
# 서버가 꺼져 있어 놓친 실행은 켜진 뒤 실행
Persistent=true
# 공식 사이트에 정각 요청이 몰리지 않도록 최대 5분 무작위 지연
RandomizedDelaySec=5min
Unit=lolypoly-collect@meals.service

[Install]
WantedBy=timers.target
