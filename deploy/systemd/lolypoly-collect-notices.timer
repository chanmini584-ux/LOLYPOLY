# Lolypoly 공지 자동 수집 — 하루 3회 (서울 시간 06:40 / 12:40 / 17:40). 시범 운영 초기값(D-040).
# 주기를 바꾸려면 OnCalendar 줄을 고치고, .env 의 LOLYPOLY_INTERVAL_NOTICES (일 단위)도 맞춘다.
[Unit]
Description=Lolypoly 공지 자동 수집 타이머

[Timer]
OnCalendar=*-*-* 06:40:00 Asia/Seoul
OnCalendar=*-*-* 12:40:00 Asia/Seoul
OnCalendar=*-*-* 17:40:00 Asia/Seoul
Persistent=true
RandomizedDelaySec=5min
Unit=lolypoly-collect@notices.service

[Install]
WantedBy=timers.target
